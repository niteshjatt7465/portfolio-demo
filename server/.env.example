# Server
PORT=5000
NODE_ENV=production

# Comma-separated origins (Vercel URL + localhost for dev)
FRONTEND_URL=https://your-portfolio.vercel.app,http://localhost:5173

# MongoDB (MongoDB Atlas)
# MONGO_URI or MONGO_URL (Atlas connection string + /database name)
MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/portfolio?retryWrites=true&w=majority

# EmailJS — https://www.emailjs.com/
EMAILJS_SERVICE_ID=your_service_id
EMAILJS_TEMPLATE_ID=your_template_id
EMAILJS_PUBLIC_KEY=your_public_key

# Telegram Bot — create via @BotFather
TELEGRAM_BOT_TOKEN=your_bot_token
TELEGRAM_CHAT_ID=your_chat_id

PORT=5000
NODE_ENV=production

# Comma-separated allowed origins
FRONTEND_URL=https://portfolio-demo-eight-lemon.vercel.app,http://localhost:5173

# MongoDB Atlas
MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/portfolio?retryWrites=true&w=majority

# Gmail (use App Password — NOT your regular Gmail password)
EMAIL_USER=your@gmail.com
EMAIL_PASS=your_16_char_app_password

# Telegram Bot (@BotFather)
TELEGRAM_BOT_TOKEN=your_bot_token
TELEGRAM_CHAT_ID=your_chat_id
